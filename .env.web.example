# LunwenToCode Web 服务部署配置
#
# 复制为 .env 并按需修改；也可直接用环境变量注入（环境变量优先级更高）

# ---------- 站点访问控制 ----------
# 设置后所有 /api 请求需带 X-Access-Token 头；留空 = 不限制
SITE_TOKEN=
# 前后端分离部署时填写允许的来源，逗号分隔；同域部署留空
CORS_ORIGINS=

# ---------- 资源限制 ----------
# 同时运行的任务数（每个任务占一个 Jupyter 内核 + 一个工作线程）
MAX_CONCURRENT_TASKS=2
# 单文件上传上限（MB）
MAX_UPLOAD_MB=20
# 单次任务允许上传的数据文件数
MAX_DATA_FILES=10
# 任务产出保留时长（小时）
TASK_TTL_HOURS=24
# 每 IP 每分钟最大任务提交数
RATE_LIMIT_PER_MINUTE=5

# ---------- 路径 ----------
# 任务产出根目录
OUTPUT_ROOT=./web_output
# 上传临时目录
UPLOAD_ROOT=./web_uploads

# ---------- 默认模型 ----------
DEFAULT_ANALYZER_MODEL=gpt-4o
DEFAULT_CODER_MODEL=gpt-4o
# 留空则与分析模型一致
DEFAULT_WRITER_MODEL=
# 留空则用官方 OpenAI 地址
DEFAULT_BASE_URL=
