# LunwenToCode 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# 分析LLM配置（用于论文分析与任务拆解）
ANALYZER_LLM_API_KEY="sk-..."
ANALYZER_LLM_MODEL="模型ID"
ANALYZER_LLM_BASE_URL=https://example/api/v1

# 代码LLM配置（用于Jupyter内核中的代码生成与执行）
CODER_LLM_API_KEY="sk-..."
CODER_LLM_MODEL="模型ID"
CODER_LLM_BASE_URL=https://example/api/v1

# 写作LLM配置（用于复现报告撰写，留空则复用分析LLM）
WRITER_LLM_API_KEY=""
WRITER_LLM_MODEL=""
WRITER_LLM_BASE_URL=

# 执行配置
MAX_CODE_RETRIES=5        # 代码错误最大反思重试次数
MAX_CHAT_TURNS=30         # 每个任务最大对话轮次
CODE_TIMEOUT=300
CODER_CONTEXT_WINDOW=128000

# 路径配置
UPLOAD_DIR=uploads
OUTPUT_DIR=output

# 日志配置
LOG_LEVEL=INFO

# Mineru API（PDF解析，可选）
MINERU_API_TOKEN=""
MINERU_API_URL=https://mineru.net/api/v4/extract/task
